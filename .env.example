# ── Django ──────────────────────────────────────────────────────────────
# Секретный ключ Django. Сгенерируй: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-secret-key

# Включить режим отладки (только для разработки)
DEBUG=False

# Разрешённые хосты через запятую. Пример: .example.com,entropy.example.com
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Доверенные источники CSRF (домены фронтенда)
CSRF_TRUSTED_ORIGINS=https://example.onrender.com,https://example.com

# ── База данных ──────────────────────────────────────────────────────────
# PostgreSQL (Render / Railway): DATABASE_URL=postgres://user:pass@host:5432/db
# SQLite (локально): оставить пустым
DATABASE_URL=

# ── Администратор ──────────────────────────────────────────────────────────
# Имя пользователя, которое имеет права администратора (доступ к секретной панели, золотым постам и т.д.)
GOD_USERNAME=admin

# ── reCAPTCHA v3 ──────────────────────────────────────────────────────────
# Получить ключи: https://www.google.com/recaptcha/admin/create
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── Cloudinary (изображения, аудио) ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Web Push (VAPID) для PWA-уведомлений ──────────────────────────────────────
# Сгенерировать: npx web-push generate-vapid-keys
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=

# ── Cron ────────────────────────────────────────────────────────────────────
# Токен для внешнего триггера cron-job.org (любая случайная строка)
CRON_SECRET_TOKEN=change-me-in-production

# ── Donation Alerts ──────────────────────────────────────────────────────────
# URL для кнопки донатов (оставь пустым, если не нужно)
DONATION_ALERTS_URL=

# ── Авторизация ──────────────────────────────────────────────────────────
LOGIN_URL=/accounts/login/

# ── Email (SMTP) ────────────────────────────────────────────────────────────
# Если EMAIL_HOST не заполнен — все функции почты (подтверждение, сброс пароля, уведомления) отключены
EMAIL_HOST=smtp.elasticemail.com
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@entropyy.ru
EMAIL_NOTIFICATIONS_FROM=Notifications@entropyy.ru

# ── Сайт ────────────────────────────────────────────────────────────────────
# URL сайта для ссылок в письмах (подтверждение email, сброс пароля)
SITE_URL=https://entropyy.ru
